# ==============================================================
# TEMPLATE BIẾN MÔI TRƯỜNG DỰ ÁN PODCYCLE - TIỆM TAI NHỎ (EXE201)
# ==============================================================

# 1. THÔNG TIN ỨNG DỤNG & LOCALHOST
VITE_APP_NAME="PODCYCLE - Trạm Chăm Sóc Tai Nghe FPT Campus"
VITE_APP_ENV="production"
VITE_APP_URL="http://localhost:5173"
VITE_HOTLINE="0901234567"
VITE_SUPPORT_EMAIL="support.podcycle@fpt.edu.vn"

# 2. CẤU HÌNH CỔNG THANH TOÁN VIETQR (NAPAS 247)
VITE_VIETQR_BANK_ID="TPB"
VITE_VIETQR_ACCOUNT_NO="07478087601"
VITE_VIETQR_ACCOUNT_NAME="CHAU THANH DAT"
VITE_VIETQR_BANK_NAME="TPBank (Tiên Phong)"

# 3. CẤU HÌNH ĐO LƯỜNG GOOGLE ANALYTICS 4 (GA4)
VITE_GA_MEASUREMENT_ID="G-TIEMTAINHO"

# 4. CẤU HÌNH KẾT NỐI CLOUD SUPABASE (POSTGRESQL THẬT)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# 5. CẤU HÌNH CỔNG THANH TOÁN SEPAY PAYMENT GATEWAY (SEPAY-PG-NODE)
# Lấy Merchant ID và Secret Key tại https://my.sepay.vn
VITE_SEPAY_ENV="sandbox" # hoặc 'production'
VITE_SEPAY_MERCHANT_ID="YOUR_MERCHANT_ID"
VITE_SEPAY_SECRET_KEY="YOUR_MERCHANT_SECRET_KEY"

# 6. CẤU HÌNH TÀI KHOẢN NGÂN HÀNG & SEPAY API V2 (AUTO-POLLING BIẾN ĐỘNG SỐ DƯ)
VITE_SEPAY_API_KEY="your-sepay-api-key"
VITE_SEPAY_ACCOUNT_NO="07478087601"
VITE_SEPAY_BANK="TPBank"
VITE_SEPAY_ACCOUNT_NAME="CHAU THANH DAT"
