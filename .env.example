# 2. CẤU HÌNH ĐO LƯỜNG GOOGLE ANALYTICS 4 (GA4)
VITE_GA_MEASUREMENT_ID="G-TIEMTAINHO"

# 3. CẤU HÌNH KẾT NỐI CLOUD SUPABASE (POSTGRESQL THẬT)
